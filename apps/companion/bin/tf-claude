#!/usr/bin/env python3
"""
Launch Claude Code with a live draft forecast.

    tf-claude [any claude arguments]

Claude Code's status line is handed session data on stdin, and that data has no
field for the prompt you are still typing — the docs list every field, and none
of them is the composer. Typing is not even an update trigger. So the only way
for a forecast to react to a draft is for something to sit between the keyboard
and Claude Code, and `tf_wrap` is that something: it runs Claude Code in a pty,
passes the keystrokes through, and publishes the *counts* of the line being
edited to a private file the status line reads.

Claude Code draws the bar itself, from `dist/statusline.js`, so there is
nothing to paint here. Codex has no such hook, which is the one thing
`bin/tf-codex` adds on top of the same launcher.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from tf_wrap import run  # noqa: E402

if __name__ == "__main__":
    sys.exit(
        run(
            program="tf-claude",
            child_env="TOKEN_FORECASTER_CLAUDE_BIN",
            child_default="claude",
        )
    )
