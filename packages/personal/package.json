{
  "name": "@token-forecaster/personal",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "Local SQLite store, hierarchical personal quantile trainer, and chronological holdout evaluation for one user's own history",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./data-dir": {
      "types": "./dist/data-dir.d.ts",
      "default": "./dist/data-dir.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@token-forecaster/core": "workspace:*",
    "@token-forecaster/predictor": "workspace:*"
  }
}
