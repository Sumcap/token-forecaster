{
  "name": "@token-forecaster/core",
  "version": "0.1.0",
  "type": "module",
  "description": "Shared schemas, context-budget calculations, forecast interfaces, and warning logic",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./prompt-features": {
      "types": "./dist/prompt-features.d.ts",
      "default": "./dist/prompt-features.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.23.8"
  }
}
