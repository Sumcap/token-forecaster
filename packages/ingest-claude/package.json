{
  "name": "@token-forecaster/ingest-claude",
  "version": "0.1.0",
  "type": "module",
  "description": "Importer for Claude Code transcript history (~/.claude/projects) that yields privacy-safe usage observations",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./load-history": {
      "types": "./load-history.d.mts",
      "default": "./load-history.mjs"
    }
  },
  "files": ["dist", "load-history.mjs", "load-history.d.mts"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@token-forecaster/core": "workspace:*"
  }
}
